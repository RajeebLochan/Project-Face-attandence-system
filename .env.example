# Copy to .env (never commit .env) or set these as real environment variables.
# Values below are PLACEHOLDERS ONLY.

# --- Required in production (Project101.settings.prod) ----------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
# Comma-separated host names, never "*".
DJANGO_ALLOWED_HOSTS=attendance.example.edu
# Needed when the site is reached through HTTPS on a different origin than Django sees.
DJANGO_CSRF_TRUSTED_ORIGINS=https://attendance.example.edu

# --- Reverse proxy / HTTPS (production) -------------------------------------
# Set to true ONLY if your proxy overwrites X-Forwarded-Proto on every request.
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false

# --- Database ---------------------------------------------------------------
# SQLite (single host):    sqlite:///db.sqlite3   (relative to the project directory)
# PostgreSQL (recommended for multiple workers/cameras):
#                          postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# --- Private storage (must NOT be inside a web-served directory) -------------
PRIVATE_MEDIA_ROOT=var/private_media
FACE_MODEL_DIR=var/models
DJANGO_CACHE_DIR=var/cache
DJANGO_STATIC_ROOT=staticfiles

# --- Recognition (distance is NOT confidence; see README) --------------------
FACE_MATCH_THRESHOLD=1.128
FACE_MATCH_MARGIN=0.10
PRIVACY_NOTICE_VERSION=1.0

# --- Development only (Project101.settings.dev) ------------------------------
DJANGO_DEBUG=true
