# Copy to .env next to docker-compose.yml and replace every placeholder.
# Never commit the real file.

# Public host name served by Caddy (DNS must point here for automatic HTTPS).
SITE_ADDRESS=attendance.example.edu
SITE_URL=https://attendance.example.edu
DJANGO_ALLOWED_HOSTS=attendance.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://attendance.example.edu
# Caddy sets X-Forwarded-Proto itself, so Django can trust it here.
DJANGO_TRUST_X_FORWARDED_PROTO=true

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://attendance:replace-with-a-long-random-password@db:5432/attendance

# SMTP from your mail provider. Leave EMAIL_HOST empty to keep e-mail off.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=attendance@example.edu
EMAIL_HOST_PASSWORD=replace-with-the-smtp-password
DEFAULT_FROM_EMAIL=Attendance <attendance@example.edu>
EMAIL_TIMEOUT=15
# Local trial with the mail catcher (docker compose --profile mailtest up) instead:
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_USE_TLS=false

GUNICORN_WORKERS=3
PRIVACY_NOTICE_VERSION=1.0
